# Environment Configuration for Credit Assistant

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Gemini AI Configuration
# Required for AI-powered credit analysis and financial recommendations
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./credit_assistant.db

# JWT & Session Security Key (Generate with: openssl rand -hex 32)
SECRET_KEY=e839b92f7d9834125a8c9b20e11894bfa268cd159842183e8fa274619385b2ad
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
APP_URL=http://localhost:3000

# Credit Score Bands (CIBIL 300 - 900)
SCORE_POOR_MAX=579
SCORE_FAIR_MAX=669
SCORE_GOOD_MAX=739
SCORE_VERY_GOOD_MAX=799
SCORE_EXCELLENT_MAX=900
